# Skills are vendored from upstream and rebuilt by bootstrap.sh from skills.manifest.
# Committing them would duplicate upstream and churn on every `skills update`.
skills/

# Machine-local state: hashes and install timestamps, regenerated by the CLI.
.skill-lock.json

# second-opinion.md is a symlink to the team repo; bootstrap.sh recreates it.
commands/second-opinion.md

# Codex copy manifests live in the target dirs, not here.
.pool-managed

*.retired
*.bak
.DS_Store
