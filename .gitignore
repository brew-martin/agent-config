# Upstream skills are vendored and rebuilt by bootstrap.sh from skills.manifest.
# Committing them would duplicate upstream and churn on every `skills update`.
# Note: `skills/*` not `skills/` - git cannot re-include a path whose parent
# directory is excluded, so the exception below would not work otherwise.
skills/*

# Locally authored skills ARE committed - they have no upstream to rebuild from.
# Add an exception per skill.
!skills/comment-sweep/

# Machine-local state: hashes and install timestamps, regenerated by the CLI.
.skill-lock.json

# Codex copy manifests live in the target dirs, not here.
.pool-managed

*.retired
*.bak
.DS_Store
